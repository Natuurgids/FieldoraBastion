# Non-secret Bastion runtime configuration only.
FIELDORA_BASTION_QUARANTINE={{ fieldora_bastion_quarantine }}
FIELDORA_BASTION_EXPORT={{ fieldora_bastion_export }}
FIELDORA_BASTION_SECRET_HANDLER={{ bastion_secret_handler }}
FIELDORA_BASTION_SECRET_HANDLER_ENDPOINT={{ bastion_secret_handler_endpoint }}
{% if bastion_keycloak_enabled %}
FIELDORA_BASTION_OIDC_ISSUER={{ bastion_keycloak_issuer }}
FIELDORA_BASTION_OIDC_AUDIENCE={{ bastion_keycloak_audience }}
{% endif %}
