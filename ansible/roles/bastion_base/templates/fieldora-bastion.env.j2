# Non-secret Bastion runtime configuration only.
FIELDORA_BASTION_QUARANTINE={{ bastion_base_quarantine }}
FIELDORA_BASTION_EXPORT={{ bastion_base_export }}
FIELDORA_BASTION_SECRET_HANDLER={{ bastion_base_secret_handler }}
FIELDORA_BASTION_SECRET_HANDLER_ENDPOINT={{ bastion_base_secret_handler_endpoint }}
FIELDORA_BASTION_SIGNER_KEY_ID={{ bastion_base_signer_key_id }}
{% if bastion_base_keycloak_enabled %}
FIELDORA_BASTION_OIDC_ISSUER={{ bastion_base_keycloak_issuer }}
FIELDORA_BASTION_OIDC_AUDIENCE={{ bastion_base_keycloak_audience }}
{% endif %}
