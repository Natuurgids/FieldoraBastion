[Unit]
Description=Fieldora Bastion
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ bastion_base_user }}
Group={{ bastion_base_group }}
WorkingDirectory={{ bastion_base_root }}
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ bastion_base_quarantine }} {{ bastion_base_export }} {{ bastion_base_runtime }}
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
EnvironmentFile=/etc/fieldora-bastion/runtime.env
ExecStart=/usr/local/bin/fieldora-bastion --help

[Install]
WantedBy=multi-user.target
